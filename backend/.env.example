# Syllaborn AI Backend Configuration
PORT=3001

# Google Gemini (Recommended - server-side secret only, never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Or OpenAI (Optional alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Allowed Frontend Origins for CORS:
# Set to your Vercel production domain and/or comma-separated origins.
# (e.g., https://syllaborn.vercel.app,http://localhost:5173)
FRONTEND_ORIGIN=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
