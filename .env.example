# Syllaborn Frontend Environment Variables

# Local Development (defaults to http://localhost:3001 if omitted in dev mode):
# VITE_API_BASE_URL=http://localhost:3001

# Production Deployment (set in Vercel Project Settings -> Environment Variables):
# Set this to your deployed Render backend URL (e.g. https://your-backend-service.onrender.com)
# Note: In production builds, Syllaborn never falls back to localhost.
VITE_API_BASE_URL=https://your-backend-service.onrender.com
